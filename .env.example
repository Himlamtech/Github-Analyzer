# ============================================================
# GitHub Analyzer — Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# ---- GitHub API ----
# Comma-separated personal access tokens (classic or fine-grained)
# Minimum scope: public_repo (read-only)
# More tokens = higher effective rate limit (5,000 req/hr per token)
GITHUB_API_TOKENS=ghp_token1,ghp_token2,ghp_token3

# ---- Kafka ----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=github_raw_events
KAFKA_RETENTION_HOURS=168

# ---- ClickHouse ----
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_USER=github_analyzer
CLICKHOUSE_PASSWORD=github_analyzer
CLICKHOUSE_DATABASE=github_analyzer

# ---- Storage paths ----
PARQUET_BASE_PATH=./data/raw
CHECKPOINT_BASE_PATH=./data/checkpoints
REPO_METADATA_PATH=./data/repos

# ---- Spark ----
SPARK_MASTER=local[16]
SPARK_DRIVER_MEMORY=8g
SPARK_EXECUTOR_MEMORY=12g
SPARK_PARQUET_MAX_RECORDS_PER_FILE=50000
SPARK_PARQUET_TARGET_PARTITIONS_PER_BATCH=8

# ---- Logging ----
LOG_LEVEL=INFO

# ---- News intelligence ----
NEWS_INTELLIGENCE_MODE=hybrid
NEWS_INTELLIGENCE_SYNC_ENABLED=true
NEWS_INTELLIGENCE_SOURCES=[{"provider":"openai","url":"https://openai.com/news/rss.xml","source_type":"rss","enabled":true},{"provider":"anthropic","url":"https://www.anthropic.com/news/rss.xml","source_type":"rss","enabled":true},{"provider":"google-ai","url":"https://blog.google/technology/ai/rss/","source_type":"rss","enabled":true}]
