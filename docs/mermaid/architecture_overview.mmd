flowchart TD
    subgraph INGEST["Lớp Ingestion"]
        GH["GitHub Events API<br/>public, ~2-3M events/ngày"]
        FILTER["PopularRepoFilter<br/>lọc AI/ML signal"]
        KAFKA["Apache Kafka<br/>16 partitions<br/>topic: github_raw_events"]
        GH -->|"Poll mỗi 60s<br/>ETag caching"| FILTER
        FILTER -->|"publish JSON"| KAFKA
    end

    subgraph PROCESS["Lớp Stream Processing"]
        SPARK["Spark Structured Streaming<br/>micro-batch 60s<br/>watermark 10 phút<br/>dedup by event_id"]
        KAFKA -->|"consume offset-based"| SPARK
    end

    subgraph STORAGE["Lớp Storage"]
        CH["ClickHouse<br/>github_data: MergeTree<br/>repo_metadata: ReplacingMergeTree<br/>repo_star_counts: SummingMergeTree"]
        PQ["Parquet / Hive<br/>data/raw/event_date=.../<br/>retention 90 ngày"]
        SPARK -->|"foreachBatch INSERT"| CH
        SPARK -->|"append mode"| PQ
    end

    subgraph SERVE["Lớp Serving"]
        API["FastAPI<br/>port 8000"]
        FE["Next.js Dashboard<br/>port 3000"]
        OLLAMA["Ollama<br/>bge-m3 embedding<br/>llama3.2:3b generation"]
        CH --> API
        API --> FE
        API <-->|"embed + generate"| OLLAMA
    end

    subgraph OBS["Lớp Observability"]
        PROM["Prometheus<br/>port 9093"]
        GRAF["Grafana<br/>port 3001"]
        API -->|"/metrics"| PROM
        PROM --> GRAF
    end
